{
  "expo": {
    "name": "CLYVO Elo",
    "slug": "clyvo-elo-mobile",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clyvoelomobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF9F5",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.fiap.clyvoelo",
      "versionCode": 4,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#3F8F68",
          "defaultChannel": "cuidados"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "br.com.fiap.clyvoelo",
      "supportsTablet": true
    },
    "extra": {
      "commitHash": "60ddf82",
      "commitData": "2026-10-29T18:09:43-03:00",
      "canal": "local",
      "router": {},
      "eas": {
        "projectId": "4ae3cb94-1d8e-46af-acc6-83d1764427b4"
      }
    },
    "owner": "gabrielcmmariano"
  }
}
